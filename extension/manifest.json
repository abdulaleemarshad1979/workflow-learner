{
  "manifest_version": 3,
  "name": "Workflow Learner \u2014 Local Companion",
  "version": "0.2.1",
  "description": "Learn and replay workflows on your own computer. Recording starts only from your local dashboard.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Workflow Learner"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "key": ""
}
